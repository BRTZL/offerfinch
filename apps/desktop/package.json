{
	"name": "@offerfinch/desktop",
	"license": "MIT",
	"productName": "OfferFinch",
	"version": "0.4.0",
	"private": true,
	"type": "module",
	"description": "OfferFinch finds matching jobs and prepares applications on your Mac. Nothing is sent without your approval.",
	"author": "OfferFinch contributors",
	"main": "out/main.cjs",
	"scripts": {
		"build": "node scripts/build.mjs",
		"dev": "node scripts/build.mjs --watch",
		"start": "electron .",
		"check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
		"test": "vitest run",
		"e2e": "node scripts/build.mjs && playwright test -c e2e/playwright.config.ts",
		"dist": "node scripts/build.mjs --production && electron-builder --mac --arm64 --x64 --publish never -c.mac.identity=- -c.mac.notarize=false -c.mac.hardenedRuntime=false",
		"dist:win": "node scripts/build.mjs --production && electron-builder --win --x64 --arm64 --publish never",
		"release": "node scripts/release.mjs",
		"eval:tailor": "vitest run --config eval/vitest.config.ts"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"playwright-core": "1.65.0"
	},
	"devDependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.319",
		"@base-ui/react": "1.9.0",
		"@formkit/auto-animate": "0.10.2",
		"@offerfinch/config": "workspace:*",
		"@offerfinch/core": "workspace:*",
		"@offerfinch/db": "workspace:*",
		"@offerfinch/local-llm": "workspace:*",
		"@offerfinch/runner": "workspace:*",
		"@orpc/client": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/tanstack-query": "^1.16.2",
		"@playwright/test": "1.65.0",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-virtual": "3.14.26",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "6.2.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.1",
		"drizzle-orm": "catalog:",
		"electron": "45.2.1",
		"electron-builder": "26.18.0",
		"electron-updater": "6.8.11",
		"esbuild": "0.28.2",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shadcn": "^4.21.0",
		"skullet": "0.0.3",
		"sonner": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "8.3.6",
		"vitest": "^5.1.0",
		"wouter": "3.13.0",
		"zod": "catalog:"
	}
}
